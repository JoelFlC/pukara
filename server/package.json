{
  "name": "pukara-server",
  "version": "1.0.0",
  "description": "Backend para PUKARA - Consulta de condiciones de lluvias intensas en sector Llojeta",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --reset",
    "db:seed": "node src/db/seed.js",
    "db:seed:capas": "node src/db/seedCapas.js",
    "meteo:inspeccionar": "node src/scripts/inspeccionarOpenMeteo.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
