# ==============================================================================
# PUKARA - Variables de Entorno del Backend Node.js / Express
# ==============================================================================

# Puerto de escucha del servidor HTTP (Render y Railway asignan PORT automáticamente)
PORT=3000

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Cadena de conexión a PostgreSQL
# Local (Docker): postgresql://postgres:postgres@localhost:5432/pukara_db
# Cloud (Neon/Supabase/Render): postgresql://user:password@ep-name.region.aws.neon.tech/pukara_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pukara_db

# Configuración SSL de Base de Datos
# false: para desarrollo local en Docker o PostgreSQL local sin TLS
# true: obligatorio para PostgreSQL gestionado en la nube (Neon, Supabase, Render)
DB_SSL=false

# Timeout para establecer conexión con el pool de PostgreSQL (milisegundos)
DB_CONNECT_TIMEOUT_MS=10000

# Política CORS (orígenes permitidos separados por comas o '*' en entornos de desarrollo/pruebas)
# Ejemplo producción: https://pukara.vercel.app,https://pukara-preview.vercel.app
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuración JWT para autenticación administrativa
JWT_SECRET=pukara_dev_jwt_secret_llojeta_2026_umsa
JWT_EXPIRES_IN=8h

# Rate limiting para endpoint de login (ventana en milisegundos y máximo de intentos)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# URL base de la API de Open-Meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Credenciales de Administrador para Seed inicial (Desarrollo / Testing)
ADMIN_SEED_EMAIL=admin@pukara.local
ADMIN_SEED_PASSWORD=PukaraAdmin2026!
ADMIN_EMAIL=admin@pukara.bo
ADMIN_PASSWORD=PukaraAdmin2026!
ADMIN_NOMBRE=Administrador PUKARA

# Coordenada central piloto Sector Llojeta / Bajo Llojeta (macrodistrito Cotahuma, La Paz)
LLOJETA_LAT=-16.5235
LLOJETA_LON=-68.1425

# Timeout de solicitud HTTP hacia Open-Meteo (milisegundos)
OPEN_METEO_TIMEOUT_MS=8000
OPEN_METEO_TIMEZONE=UTC

# Caché en memoria del servidor para lecturas meteorológicas (ventana canónica de 10 a 15 minutos)
LECTURAS_CACHE_TTL_MINUTOS=12
