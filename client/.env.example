# PUKARA - Variables de Entorno del Cliente Web Mobile-First

# URL base de la API backend
# En desarrollo local: dejar vacío o comentar para usar el proxy de Vite en /api (http://localhost:3000)
# En producción (Vercel / Netlify): URL pública del backend (ej. https://pukara-backend.onrender.com)
VITE_API_URL=

# Fallback retrocompatible para la ruta base de API local
VITE_API_BASE_URL=/api

# Proveedor de teselas cartográficas (OpenStreetMap)
# Restricción: Prohibida la descarga masiva de teselas.
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
