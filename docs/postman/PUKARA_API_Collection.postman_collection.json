    {
      "name": "03 - Administración de Reglas y Umbrales (P05, P16)",
      "description": "Validación de coherencia matemática de umbrales (P16) y ciclo de versionado inmutable (P05).",
      "item": [
        {
          "name": "3.1 GET /api/admin/configuraciones — Listar versiones de reglas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200 OK con versiones de configuración', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.true;",
                  "  pm.expect(jsonData.versiones).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/configuraciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "configuraciones"]
            }
          }
        },
        {
          "name": "3.2 POST /api/admin/configuraciones — Rechazo de configuración incoherente (400 P16)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza configuración incoherente con HTTP 400 (P16)', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.false;",
                  "  pm.expect(jsonData.error.codigo).to.eql('CONFIGURACION_INVALIDA');",
                  "  pm.expect(jsonData.error.detalles).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Prueba P16 de umbrales incoherentes (PRECAUCION >= ALERTA y 24h > 72h)\",\n  \"activar\": false,\n  \"umbrales\": [\n    { \"variable\": \"intensidad_mm_h\", \"nivel\": \"PRECAUCION\", \"valor\": -1.5 },\n    { \"variable\": \"intensidad_mm_h\", \"nivel\": \"ALERTA\", \"valor\": 6.5 },\n    { \"variable\": \"intensidad_mm_h\", \"nivel\": \"EMERGENCIA\", \"valor\": 5.0 },\n    { \"variable\": \"acum_24h_mm\", \"nivel\": \"PRECAUCION\", \"valor\": 10.0 },\n    { \"variable\": \"acum_24h_mm\", \"nivel\": \"ALERTA\", \"valor\": 70.0 },\n    { \"variable\": \"acum_24h_mm\", \"nivel\": \"EMERGENCIA\", \"valor\": 80.0 },\n    { \"variable\": \"acum_72h_mm\", \"nivel\": \"PRECAUCION\", \"valor\": 25.0 },\n    { \"variable\": \"acum_72h_mm\", \"nivel\": \"ALERTA\", \"valor\": 60.0 },\n    { \"variable\": \"acum_72h_mm\", \"nivel\": \"EMERGENCIA\", \"valor\": 90.0 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/configuraciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "configuraciones"]
            }
          }
        },
        {
          "name": "3.3 POST /api/admin/configuraciones — Crear nueva versión válida en borrador (201 P05)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crea nueva versión coherente en estado borrador (201)', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.true;",
                  "  pm.expect(jsonData.configuracion.estado).to.eql('borrador');",
                  "  pm.expect(jsonData.configuracion.umbrales).to.have.lengthOf(9);",
                  "  pm.collectionVariables.set('configBorradorId', jsonData.configuracion.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Calibración académica de umbrales versión de prueba Postman S4D1\",\n  \"activar\": false,\n  \"parametros\": {\n    \"t_max_minutos\": 60,\n    \"separacion_minima_minutos\": 15,\n    \"muestras_descenso\": 2\n  },\n  \"umbrales\": [\n    { \"variable\": \"intensidad_mm_h\", \"nivel\": \"PRECAUCION\", \"valor\": 2.5 },\n    { \"variable\": \"intensidad_mm_h\", \"nivel\": \"ALERTA\", \"valor\": 6.5 },\n    { \"variable\": \"intensidad_mm_h\", \"nivel\": \"EMERGENCIA\", \"valor\": 12.0 },\n    { \"variable\": \"acum_24h_mm\", \"nivel\": \"PRECAUCION\", \"valor\": 10.0 },\n    { \"variable\": \"acum_24h_mm\", \"nivel\": \"ALERTA\", \"valor\": 25.0 },\n    { \"variable\": \"acum_24h_mm\", \"nivel\": \"EMERGENCIA\", \"valor\": 40.0 },\n    { \"variable\": \"acum_72h_mm\", \"nivel\": \"PRECAUCION\", \"valor\": 25.0 },\n    { \"variable\": \"acum_72h_mm\", \"nivel\": \"ALERTA\", \"valor\": 60.0 },\n    { \"variable\": \"acum_72h_mm\", \"nivel\": \"EMERGENCIA\", \"valor\": 90.0 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/configuraciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "configuraciones"]
            }
          }
