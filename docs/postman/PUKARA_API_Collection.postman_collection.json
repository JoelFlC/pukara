  "item": [
    {
      "name": "01 - Salud y Consulta Pública",
      "description": "Endpoints públicos de salud operativa, estado consolidado del nivel informativo de lluvia e historial paginado.",
      "item": [
        {
          "name": "1.1 GET /api/salud — Estado del servicio y PostgreSQL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Estado del servicio es ok y base de datos conectada', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.estado).to.eql('ok');",
                  "  pm.expect(jsonData.base_de_datos).to.eql('conectado');",
                  "  pm.expect(jsonData).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/salud",
              "host": ["{{baseUrl}}"],
              "path": ["api", "salud"]
            }
          }
        },
        {
          "name": "1.2 GET /api/estado — Consulta pública integral (Modalidad Real)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Estructura completa del contrato público v1', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.true;",
                  "  pm.expect(jsonData.modalidad).to.eql('real');",
                  "  pm.expect(jsonData).to.have.any.keys('nivel_vigente', 'estado_sistema');",
                  "  pm.expect(jsonData).to.have.property('lectura');",
                  "  pm.expect(jsonData).to.have.property('antiguedad_minutos');",
                  "  pm.expect(jsonData).to.have.property('recomendacion_vigente');",
                  "  pm.expect(jsonData.recomendaciones).to.be.an('array').that.has.lengthOf.at.least(4);",
                  "  pm.expect(jsonData.contactos_emergencia).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(jsonData.zonas_referencia).to.be.an('array').that.has.lengthOf(2);",
                  "  pm.expect(jsonData.puntos_referencia).to.be.an('array').that.has.lengthOf(6);",
                  "  pm.expect(jsonData).to.have.property('version_reglas');",
                  "});",
                  "pm.test('Incluye el Aviso Permanente obligatorio de nivel informativo de lluvia', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.aviso_permanente).to.include('niveles informativos de lluvia');",
                  "  pm.expect(jsonData.aviso_permanente).to.include('umbrales académicos');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "estado"]
            }
          }
        },
        {
          "name": "1.3 GET /api/estado?modalidad=simulada — Consulta pública aislada en modo simulación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Verifica aislamiento de consulta en modalidad simulada (P11)', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.true;",
                  "  pm.expect(jsonData.modalidad).to.eql('simulada');",
                  "  pm.expect(jsonData.es_simulacion).to.be.true;",
                  "  pm.expect(jsonData.banner_simulacion).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/estado?modalidad=simulada",
              "host": ["{{baseUrl}}"],
              "path": ["api", "estado"],
              "query": [
                {
                  "key": "modalidad",
