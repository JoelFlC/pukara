    {
      "name": "04 - Administración de Contenidos, Capas y Bitácora",
      "description": "Gestión de recomendaciones preventivas, contactos de emergencia, inmutabilidad cartográfica y auditoría en bitácora.",
      "item": [
        {
          "name": "4.1 GET /api/admin/recomendaciones — Listar recomendaciones con etiqueta de origen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200 OK y verifica campo origen en recomendaciones', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.true;",
                  "  pm.expect(jsonData.recomendaciones).to.be.an('array').that.is.not.empty;",
                  "  jsonData.recomendaciones.forEach((rec) => {",
                  "    pm.expect(rec.origen).to.be.oneOf(['demostracion', 'institucional_verificada']);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/recomendaciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "recomendaciones"]
            }
          }
        },
        {
          "name": "4.2 PUT /api/admin/recomendaciones/1 — Actualizar recomendación preventiva",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Actualiza recomendación y conserva etiqueta de origen válida', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.true;",
                  "  pm.expect(jsonData.recomendacion.origen).to.be.oneOf(['demostracion', 'institucional_verificada']);",
                  "});"
