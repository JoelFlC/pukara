            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pukara.bo\",\n  \"password\": \"ClaveIncorrecta123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
