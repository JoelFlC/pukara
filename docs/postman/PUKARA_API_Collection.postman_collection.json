    {
      "name": "02 - Autenticación y Seguridad (P07)",
      "description": "Pruebas de autenticación administrativa con JWT y control de acceso basado en roles (Prueba P07).",
      "item": [
        {
          "name": "2.1 POST /api/auth/login — Login exitoso y captura de token JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde HTTP 200 OK con token JWT válido', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.true;",
                  "  pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(jsonData.usuario.rol).to.eql('administrador');",
                  "  pm.collectionVariables.set('adminToken', jsonData.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pukara.bo\",\n  \"password\": \"PukaraAdmin2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2.2 POST /api/auth/login — Rechazo con contraseña inválida (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza credenciales inválidas con HTTP 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.ok).to.be.false;",
                  "  pm.expect(jsonData.error.codigo).to.eql('CREDENCIALES_INVALIDAS');",
